FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including Playwright browser dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    # Playwright dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    fonts-liberation \
    fonts-noto-color-emoji \
    # GTK3 runtime for Camoufox (minimal, no dev packages)
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install ONLY Chromium (not Firefox - saves 500MB)
# Install without --with-deps since we already have the dependencies above
RUN playwright install chromium

# Install Camoufox (used by your scrapers for anti-detection)
RUN camoufox fetch

# Copy application code
COPY . .

# Worker command (overridden in docker-compose)
CMD ["celery", "-A", "tasks.scrape_task", "worker", "--loglevel=info"]
