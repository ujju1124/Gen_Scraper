# ============================================================================
# Gen_Scraper Configuration File
# ============================================================================
# Copy this file to .env and configure based on your system requirements.
# Never commit .env to version control - it contains your secrets!
#
# IMPORTANT: All settings are customizable. Adjust based on your:
# - System resources (CPU, RAM)
# - Scraping requirements (speed vs. politeness)
# - Production vs. development environment
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, or production
ENV=development

# Secret key for session encryption and security
# IMPORTANT: Generate a random 64+ character string for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-this-to-a-random-64-char-string-in-production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# NOTE: Use 'postgres' as host when running in Docker, 'localhost' when running locally
DATABASE_URL=postgresql://scraper:scraper_pass@postgres:5432/scraper_db

# Database credentials (used by Docker containers)
POSTGRES_DB=scraper_db
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper_pass

# ============================================================================
# REDIS & CELERY (Background Jobs)
# ============================================================================

# Redis connection string
# NOTE: Use 'redis' as host when running in Docker, 'localhost' when running locally
REDIS_URL=redis://redis:6379/0

# Celery worker concurrency (number of parallel background tasks)
# RECOMMENDATIONS:
# - Low-end system (2-4 CPU cores): 1-2
# - Mid-range system (4-8 CPU cores): 2-4
# - High-end system (8+ CPU cores): 4-8
# - Production server: (CPU cores - 1) or (CPU cores - 2)
CELERY_CONCURRENCY=2

# ============================================================================
# SCRAPER SETTINGS
# ============================================================================

# Mock mode (for testing without actual scraping)
# Set to 'true' to return fake data, 'false' for real scraping
MOCK_MODE=false

# ============================================================================
# GO SCRAPER MICROSERVICE (Google Maps Scraper)
# ============================================================================

# Go Scraper service URL
# NOTE: Use 'go_scraper' as host when running in Docker, 'localhost:8080' when running locally
GO_SCRAPER_URL=http://go_scraper:8080

# API key for Go Scraper authentication
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: python -c "import secrets; print('gms_' + secrets.token_hex(32))"
GO_SCRAPER_API_KEY=your-api-key-here

# Enable/disable Go Scraper
# Set to 'true' to use Go Scraper, 'false' to disable
GO_SCRAPER_ENABLED=true

# Go Scraper timeout in seconds
# How long to wait for scraper to complete before timing out
# RECOMMENDATIONS:
# - Small jobs (1-20 results): 60-120 seconds
# - Medium jobs (20-100 results): 120-240 seconds
# - Large jobs (100+ results): 240-600 seconds
GO_SCRAPER_TIMEOUT=200

# Polling interval in seconds
# How often to check if scraping job is complete
# RECOMMENDATIONS:
# - Fast polling (more API calls): 2-3 seconds
# - Balanced: 3-5 seconds
# - Slow polling (fewer API calls): 5-10 seconds
GO_SCRAPER_POLL_INTERVAL=3

# ============================================================================
# DETAIL PAGE SCRAPING CONFIGURATION
# ============================================================================
# These settings control how many detail pages are scraped per job
# and the delays between requests to avoid rate limiting.
#
# IMPORTANT: Higher values = more data but slower scraping and higher load
# ============================================================================

# Maximum number of detail pages to scrape per job
# RECOMMENDATIONS:
# - Testing/Development: 2-5
# - Light scraping: 10-20
# - Medium scraping: 20-50
# - Heavy scraping: 50-100
# - Unlimited: 999999 (use with caution!)
# NOTE: More detail pages = more time and resources required
MAX_DETAIL_PAGES_PER_JOB=2

# Minimum delay between detail page requests (in milliseconds)
# RECOMMENDATIONS:
# - Polite/Safe: 2000-3000 ms (2-3 seconds)
# - Balanced: 1000-2000 ms (1-2 seconds)
# - Aggressive: 500-1000 ms (0.5-1 second)
# WARNING: Too low may trigger rate limiting or IP blocks!
DETAIL_PAGE_DELAY_MIN=2000

# Maximum delay between detail page requests (in milliseconds)
# Should be higher than DETAIL_PAGE_DELAY_MIN for randomization
# RECOMMENDATIONS:
# - Polite/Safe: 3000-5000 ms (3-5 seconds)
# - Balanced: 2000-4000 ms (2-4 seconds)
# - Aggressive: 1000-2000 ms (1-2 seconds)
DETAIL_PAGE_DELAY_MAX=4000

# ============================================================================
# ADMIN USER CONFIGURATION
# ============================================================================
# These credentials are used to create the initial admin user
# when the system starts for the first time.
#
# SECURITY NOTES:
# - Use a STRONG password (20+ characters, mixed case, numbers, symbols)
# - Use your real email if you want to receive notifications
# - These are YOUR credentials - not the examples in documentation!
# - Never use 'admin123' or other weak passwords in production!
# ============================================================================

# Admin password
# IMPORTANT: Set a strong password here!
# Example: MyStr0ng!P@ssw0rd#2026
ADMIN_PASSWORD=

# Admin email address
# Example: admin@yourcompany.com
ADMIN_EMAIL=

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================

# Sentry DSN for error tracking (optional)
# Leave empty to disable error tracking
# Get your DSN from: https://sentry.io/
SENTRY_DSN=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend URL (where the web interface is hosted)
FRONTEND_URL=http://localhost:5173

# Backend API URL (used by frontend to make API calls)
VITE_API_URL=http://localhost:8000

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
# Configure SMTP settings to send email notifications
# Leave empty to disable email features
#
# For Gmail:
# 1. Enable 2-factor authentication
# 2. Generate an "App Password" at: https://myaccount.google.com/apppasswords
# 3. Use the app password (not your regular password)
# ============================================================================

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP password (use app password for Gmail)
SMTP_PASSWORD=your-app-password

# From email address (shown as sender)
SMTP_FROM_EMAIL=noreply@example.com

# ============================================================================
# DATA RETENTION
# ============================================================================

# Number of days to keep raw scraping results before cleanup
# RECOMMENDATIONS:
# - Short-term projects: 30 days
# - Standard: 90 days
# - Long-term: 180-365 days
# - Permanent: 999999 (not recommended - database will grow large)
RAW_RESULTS_RETENTION_DAYS=90

# ============================================================================
# PERFORMANCE TUNING TIPS
# ============================================================================
#
# For LOW-END systems (2-4 CPU cores, 4-8 GB RAM):
# - CELERY_CONCURRENCY=1
# - MAX_DETAIL_PAGES_PER_JOB=2
# - GO_SCRAPER_TIMEOUT=120
# - DETAIL_PAGE_DELAY_MIN=2000
# - DETAIL_PAGE_DELAY_MAX=4000
#
# For MID-RANGE systems (4-8 CPU cores, 8-16 GB RAM):
# - CELERY_CONCURRENCY=2-4
# - MAX_DETAIL_PAGES_PER_JOB=20
# - GO_SCRAPER_TIMEOUT=240
# - DETAIL_PAGE_DELAY_MIN=1000
# - DETAIL_PAGE_DELAY_MAX=3000
#
# For HIGH-END systems (8+ CPU cores, 16+ GB RAM):
# - CELERY_CONCURRENCY=4-8
# - MAX_DETAIL_PAGES_PER_JOB=50-100
# - GO_SCRAPER_TIMEOUT=300
# - DETAIL_PAGE_DELAY_MIN=500
# - DETAIL_PAGE_DELAY_MAX=2000
#
# For PRODUCTION servers:
# - Use strong passwords and API keys
# - Set ENV=production
# - Enable SENTRY_DSN for error tracking
# - Configure email notifications
# - Use appropriate retention days
# - Monitor system resources and adjust accordingly
#
# ============================================================================
